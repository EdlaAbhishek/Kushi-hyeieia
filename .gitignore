# ==============================================================
# Kushi Hygieia — .gitignore
# ==============================================================

# --- Secrets & Credentials ---
.env
.env*.local
credentials.json
token.json

# --- Temporary files (always regenerable) ---
tmp/*
!tmp/.gitkeep
scratch/
python/scratch/
*.traineddata
*.mp4

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Node ---
node_modules/
frontend/node_modules/
backend/node_modules/

# --- Build outputs ---
frontend/dist/
backend/dist/
dist/

# --- Logs & Test Artifacts ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
testsprite_tests/
supabase/.temp/
appt_schema.json
output.json
db_*.json
